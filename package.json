{
  "name": "contract-scanner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --experimental-test-isolation=none --test test/normalize.test.mjs test/endpoint.test.mjs test/apikey.test.mjs test/description.test.mjs test/cache.test.mjs test/prompt.test.mjs test/score.test.mjs test/scorecache.test.mjs",
    "build-fixture": "node --experimental-strip-types scripts/build-fixture.mjs",
    "labels": "node --experimental-strip-types scripts/make-labels.mjs",
    "score": "node --experimental-strip-types scripts/score-harness.mjs",
    "probe": "node --experimental-strip-types scripts/probe-endpoint.mjs",
    "diagnose": "node --experimental-strip-types scripts/diagnose-ui-endpoint.mjs",
    "harvest": "node --experimental-strip-types scripts/harvest.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "typescript": "^5.7.3",
    "wrangler": "^3.101.0"
